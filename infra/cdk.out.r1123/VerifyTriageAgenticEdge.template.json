{
 "Description": "Phishing triage sample: CloudFront WAF (us-east-1)",
 "Metadata": {
  "cdk_nag": {
   "rules_to_suppress": [
    {
     "reason": "Every route but /health requires IAM SigV4, the resource policy limits callers to this account, and the stage is throttled. The console path is covered by the CloudFront WAF; a regional WAF adds no control an IAM-only API needs.",
     "id": "AwsSolutions-APIG3"
    },
    {
     "reason": "Only GET /health has no authorizer: a liveness probe that returns {\"ok\": true} and no data. Every other route uses AuthorizationType IAM.",
     "id": "AwsSolutions-APIG4"
    },
    {
     "reason": "The API authenticates with IAM SigV4 (the console proxy role or a caller's own principal), not a Cognito authorizer; the proxy verifies the Cognito session.",
     "id": "AwsSolutions-COG4"
    },
    {
     "reason": "Only with the default -c mfa=optional: TOTP is offered to every user but not forced, a sample-usability choice. Deploy with -c mfa=required to force it (then this check passes). Sign-up is gated by an emailed temporary password, the WAF register rate limit and the optional invite code.",
     "id": "AwsSolutions-COG2"
    },
    {
     "reason": "Only with the default -c cognitoPlan=essentials: PLUS (threat protection) has no free tier. Deploy with -c cognitoPlan=plus for the PLUS plan with threat protection enforced (then this check passes).",
     "id": "AwsSolutions-COG8"
    },
    {
     "reason": "AWS managed baseline logging policies only (AWSLambdaBasicExecutionRole on CDK-created function roles, AmazonAPIGatewayPushToCloudWatchLogs on the API Gateway account role).",
     "id": "AwsSolutions-IAM4",
     "applies_to": [
      {
       "regex": "/^Policy::arn:<AWS::Partition>:iam::aws:policy\\/service-role\\/(AWSLambdaBasicExecutionRole|AmazonAPIGatewayPushToCloudWatchLogs)$/g"
      }
     ]
    },
    {
     "reason": "No geo restriction: the sample console is meant to be reachable from any region. Add one for a production audience.",
     "id": "AwsSolutions-CFR1"
    },
    {
     "reason": "Only without -c domainName/-c certificateArn: the default *.cloudfront.net certificate ignores the viewer TLS policy. With a custom domain and its ACM certificate the distribution pins TLSv1.2_2021 and this check passes.",
     "id": "AwsSolutions-CFR4"
    },
    {
     "reason": "Functions pin python3.13, the interpreter the uv workspace and its locked wheels target; CDK-managed singleton functions run the runtime CDK chooses.",
     "id": "AwsSolutions-L1"
    },
    {
     "reason": "The optional invite code is a shared value read on demand; rotating means replacing the value, which takes effect immediately. No database credential.",
     "id": "AwsSolutions-SMG4"
    },
    {
     "reason": "The stats stream DLQ and the batch DLQ are themselves dead-letter destinations (the DynamoDB stream event source's and the splitter's async on-failure targets), and each has an alarm when not empty.",
     "id": "AwsSolutions-SQS3"
    },
    {
     "reason": "Only actions without resource-level permissions: X-Ray PutTraceSegments, PutTelemetryRecords and GetSampling*, ecr:GetAuthorizationToken, dynamodb:ListStreams, and cloudwatch:PutMetricData (limited by a cloudwatch:namespace condition).",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/Resource::\\*/g"
      }
     ]
    },
    {
     "reason": "Cross-region and global inference profiles are served from several regions, so the profile and foundation-model ARNs carry a region wildcard; the model id is fixed.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/:bedrock:\\*:/g"
      }
     ]
    },
    {
     "reason": "Queries use the table GSIs, whose ARNs are the table ARN plus /index/<name>.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/\\/index\\/\\*/g"
      }
     ]
    },
    {
     "reason": "Artifacts and findings are keyed by scan id at runtime; bounded to the scans/ prefix of the artifacts bucket.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/\\/scans\\/\\*/g"
      }
     ]
    },
    {
     "reason": "Batch HTML reports are keyed by batch id at runtime; bounded to one object name under the batches/ prefix of the artifacts bucket.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/\\/batches\\/\\*\\/report\\.html/g"
      }
     ]
    },
    {
     "reason": "Upload keys contain the batch id at runtime; bounded to uploads/ of one bucket.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/\\/uploads\\/\\*/g"
      }
     ]
    },
    {
     "reason": "Browser session ids are minted per scan; bounded to this account's sessions of the AWS-managed browser.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/browser-session\\/\\*/g"
      }
     ]
    },
    {
     "reason": "InvokeAgentRuntime also authorizes the runtime endpoint ARN; endpoints are service-named under the three runtimes in this stack.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/runtime-endpoint\\/\\*/g"
      }
     ]
    },
    {
     "reason": "The harness ARN and its managed memory ARN carry a service-generated suffix (Phase 0 spike).",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/_orchestrator-\\*/g"
      }
     ]
    },
    {
     "reason": "AgentCore writes to log groups it names under the harness or runtime prefix, with a generated suffix and per-session streams.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/log-group:\\/aws\\/bedrock-agentcore\\//g"
      }
     ]
    },
    {
     "reason": "logs:DescribeLogGroups (granted by the Runtime L2) only supports the account-level log-group wildcard.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/log-group:\\*/g"
      }
     ]
    },
    {
     "reason": "Runtime workload identities are created and named by the service (Runtime L2 grant).",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/workload-identity\\/\\*/g"
      }
     ]
    },
    {
     "reason": "The path wildcard stands for the {id} path parameter of one method on this API and stage; every route is listed explicitly.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/:execute-api:/g"
      }
     ]
    },
    {
     "reason": "CDK BucketDeployment reads its source zip from the bootstrap bucket.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/cdk-hnb659fds-assets-/g"
      }
     ]
    },
    {
     "reason": "CDK BucketDeployment syncs the SPA build into the console assets bucket.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/WebAssets/g"
      }
     ]
    },
    {
     "reason": "Lambda grant_invoke covers the function's versions and aliases (ARN plus :*).",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/Arn>:\\*/g"
      }
     ]
    },
    {
     "reason": "CDK grant helpers use ReEncrypt* on one key (the data CMK).",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/Action::kms:ReEncrypt\\*/g"
      }
     ]
    },
    {
     "reason": "CDK grant helpers use GenerateDataKey* on the data CMK.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/Action::kms:GenerateDataKey\\*/g"
      }
     ]
    },
    {
     "reason": "CDK BucketDeployment grant on the bootstrap and assets buckets.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/Action::s3:GetObject\\*/g"
      }
     ]
    },
    {
     "reason": "CDK BucketDeployment grant on the bootstrap and assets buckets.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/Action::s3:GetBucket\\*/g"
      }
     ]
    },
    {
     "reason": "CDK BucketDeployment grant on the bootstrap and assets buckets.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/Action::s3:List\\*/g"
      }
     ]
    },
    {
     "reason": "CDK BucketDeployment prunes old SPA files in the assets bucket.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/Action::s3:DeleteObject\\*/g"
      }
     ]
    },
    {
     "reason": "CDK BucketDeployment grant on the console assets bucket.",
     "id": "AwsSolutions-IAM5",
     "applies_to": [
      {
       "regex": "/Action::s3:Abort\\*/g"
      }
     ]
    }
   ]
  }
 },
