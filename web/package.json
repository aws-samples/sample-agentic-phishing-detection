{
  "name": "phish-triage-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Analyst console for the GenAI phishing detection sample (static SPA).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "devproxy": "API_BASE_URL=${API_BASE_URL:-} python3 devproxy/sign_proxy.py"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "recharts": "2.13.3",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.0.1",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.68.0",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
